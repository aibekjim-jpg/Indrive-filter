<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="InDrive Filter"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>
        <EditText android:id="@+id/etMinPrice"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Min price" android:inputType="number"/>
        <EditText android:id="@+id/etPickup"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Max pickup km" android:inputType="numberDecimal"/>
        <EditText android:id="@+id/etMinTrip"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Min trip km" android:inputType="numberDecimal"/>
        <EditText android:id="@+id/etMaxTrip"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Max trip km" android:inputType="numberDecimal"/>
        <EditText android:id="@+id/etDistricts"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Districts (comma)" android:inputType="text"/>
        <CheckBox android:id="@+id/cbCash"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cash only"/>
        <CheckBox android:id="@+id/cbAuto"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Auto accept"/>
        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Save and enable" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnAccess"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Accessibility" android:layout_marginTop="8dp"/>
        <Button android:id="@+id/btnOverlay"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Overlay permission" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
